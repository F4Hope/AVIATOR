# Filled automatically by deploy/windows/setup-aie.ps1 after Tailscale login.
AIE_TAILSCALE_HOST=replace-with-device.tailnet-name.ts.net

# Generate a long random value. setup-aie.ps1 generates one if this placeholder
# is still present.
AIE_BROWSERLESS_TOKEN=replace-with-a-long-random-token

# Replace with the exact BetPawa Aviator HTTPS page used by your account.
AIE_BETPAWA_AVIATOR_URL=https://www.betpawa.cm/

AIE_DATABASE_FILENAME=aie.sqlite3
AIE_LOG_LEVEL=INFO
