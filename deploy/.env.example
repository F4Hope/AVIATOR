AIE_APP_DOMAIN=app.example.com
AIE_BROWSER_DOMAIN=browser.example.com
AIE_BASIC_AUTH_USER=aie
# Generate with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'CHOOSE-A-LONG-PASSWORD'
# Keep the resulting bcrypt hash single-quoted so Docker Compose treats $ literally.
AIE_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_CADDY_HASH'

# Generate a long random value. Never commit the real token.
AIE_BROWSERLESS_TOKEN=replace-with-a-long-random-token

# Set this to the exact BetPawa Aviator HTTPS page you use.
AIE_BETPAWA_AVIATOR_URL=https://www.betpawa.cm/

AIE_DATABASE_FILENAME=aie.sqlite3
AIE_LOG_LEVEL=INFO
